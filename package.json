{
  "name": "obsidian-hybrid-search-plugin",
  "version": "0.9.1",
  "description": "Obsidian plugin — hybrid search via obsidian-hybrid-search CLI",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "postversion": "git push origin master && git push origin --tags",
    "test": "npm run review:obsidian && npm run test:unit",
    "test:unit": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "review:obsidian": "npm run review:obsidian:code && npm run review:obsidian:metadata",
    "review:obsidian:code": "eslint --config eslint.obsidian.config.mjs src",
    "review:obsidian:metadata": "eslint --config eslint.obsidian.metadata.config.mjs --no-error-on-unmatched-pattern manifest.json package.json LICENSE \"src/**/*.json\"",
    "review:local": "npm run review:obsidian && npm run lint && npm audit --omit=dev --audit-level=moderate && npm run build && npm run test:unit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip"
  },
  "keywords": [],
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^9.39.4",
    "@eslint/json": "^0.14.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.9.3",
    "@vitest/coverage-v8": "^4.1.9",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.3.0",
    "eslint-plugin-sonarjs": "^4.0.3",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "knip": "^6.17.1",
    "prettier": "^3.8.4",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "obsidian": "^1.13.1"
  },
  "overrides": {
    "fast-uri": "^3.1.4",
    "js-yaml": "^4.3.0",
    "postcss": "^8.5.24"
  }
}
