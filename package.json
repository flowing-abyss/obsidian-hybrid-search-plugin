{
  "name": "obsidian-hybrid-search-plugin",
  "version": "0.11.0",
  "description": "Obsidian plugin — hybrid search via obsidian-hybrid-search CLI",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "postversion": "git push origin master && git push origin --tags",
    "test": "pnpm run review:obsidian && pnpm run test:unit",
    "test:unit": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "review:obsidian": "pnpm run review:obsidian:code && pnpm run review:obsidian:metadata",
    "review:obsidian:code": "eslint --config eslint.obsidian.config.mjs src",
    "review:obsidian:metadata": "eslint --config eslint.obsidian.metadata.config.mjs --no-error-on-unmatched-pattern manifest.json package.json LICENSE \"src/**/*.json\"",
    "review:local": "pnpm run verify",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "release": "pnpm version --tag-version-prefix \"\"",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "check:architecture": "depcruise src --config dependency-cruiser.config.cjs --output-type err",
    "verify:task": "pnpm run review:obsidian && pnpm run lint && pnpm run typecheck && pnpm run check:architecture && pnpm run test:unit",
    "verify": "pnpm run review:obsidian && pnpm run lint && pnpm run typecheck && pnpm run check:architecture && pnpm run format:check && pnpm run coverage && pnpm run knip && pnpm run build && pnpm audit --audit-level=moderate"
  },
  "keywords": [],
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "9.39.5",
    "@eslint/json": "0.14.0",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "dependency-cruiser": "18.7.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-depend": "1.3.1",
    "eslint-plugin-obsidianmd": "0.4.2",
    "eslint-plugin-sonarjs": "4.2.2",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "jsdom": "30.1.3",
    "knip": "6.43.0",
    "obsidian": "1.14.4",
    "obsidian-test-mocks": "7.3.0",
    "prettier": "3.9.10",
    "prettier-plugin-organize-imports": "4.3.0",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "pnpm": ">=12.15.0 <13"
  },
  "packageManager": "pnpm@12.15.0"
}
